generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AvailabilityBlockSource {
  MANUAL
  BOOKING
}

model User {
  id       String @id @default(cuid())
  fullName String

  email String? @unique
  phone String? @unique

  // Password is never stored directly.
  // Only the bcrypt hash is stored here.
  passwordHash String?

  // Optional marketing / correspondence preference.
  marketingEmailsOptIn   Boolean   @default(false)
  marketingEmailsOptInAt DateTime?

  role   UserRole      @default(CUSTOMER)
  status AccountStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  vendorProfile     VendorProfile?
  verificationCodes VerificationCode[]
  sessions          Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Completed later during vendor onboarding.
  businessName String?

  // Legacy field retained temporarily.
  primaryCategory String?

  // Vendor can operate in multiple marketplace segments.
  segments String[] @default([])

  // ---------------------------------------
  // LOCATION
  // ---------------------------------------

  country String @default("Nigeria")
  state   String?
  city    String?

  // ---------------------------------------
  // RATINGS
  // ---------------------------------------

  // These will later be calculated from real reviews.
  // Vendors should never edit these themselves.
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  // ---------------------------------------
  // VERIFICATION
  // ---------------------------------------

  kycStatus    VerificationStatus @default(NOT_STARTED)
  payoutStatus VerificationStatus @default(NOT_STARTED)

  // ---------------------------------------
  // RELATIONSHIPS
  // ---------------------------------------

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings           Listing[]
  availabilityBlocks VendorAvailabilityBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([city])
  @@index([averageRating])
  @@index([kycStatus])
}

model VerificationCode {
  id String @id @default(cuid())

  userId String

  codeHash String

  channel     VerificationChannel
  purpose     VerificationPurpose @default(SIGNUP)
  destination String

  expiresAt DateTime
  usedAt    DateTime?

  attempts Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}

model Session {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id String @id @default(cuid())

  vendorProfileId String

  title       String
  slug        String
  description String?

  category String

  // Money is stored in kobo.
  // Example:
  // ₦2,500 = 250000 kobo.
  priceKobo Int

  pricingUnit String?

  status      ListingStatus @default(DRAFT)
  isAvailable Boolean       @default(true)

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorProfileId, slug])

  @@index([vendorProfileId])
  @@index([status])
  @@index([category])
  @@index([priceKobo])
  @@index([isAvailable])
  @@index([category, priceKobo])
}

model VendorAvailabilityBlock {
  id String @id @default(cuid())

  vendorProfileId String

  // Vendor is unavailable from startDate through endDate.
  startDate DateTime
  endDate   DateTime

  // Examples:
  // Private event
  // Equipment unavailable
  // Already booked
  reason String?

  // MANUAL:
  // vendor blocks the dates themselves.
  //
  // BOOKING:
  // Flamingo will eventually create the block
  // automatically from a confirmed booking.
  source AvailabilityBlockSource @default(MANUAL)

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorProfileId])
  @@index([startDate])
  @@index([endDate])
  @@index([vendorProfileId, startDate, endDate])
}