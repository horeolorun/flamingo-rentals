
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AvailabilityBlockSource {
  MANUAL
  BOOKING
}

enum BookingStatus {
  PENDING_VENDOR_APPROVAL
  ACCEPTED
  REJECTED
  PAID
  CANCELLED
  COMPLETED
}

model User {
  id        String  @id @default(cuid())
  fullName  String

  // Customer's saved location
  state     String?
  city      String?

  email     String? @unique
  phone     String? @unique

  passwordHash String?

  marketingEmailsOptIn   Boolean   @default(false)
  marketingEmailsOptInAt DateTime?

  role   UserRole      @default(CUSTOMER)
  status AccountStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  vendorProfile     VendorProfile?
  verificationCodes VerificationCode[]
  sessions          Session[]

  cart     Cart?
  bookings Booking[] @relation("CustomerBookings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique

  businessName String?

  // Vendor branding
  logoUrl    String?
  isFeatured Boolean @default(false)

  // Legacy field retained temporarily
  primaryCategory String?

  // Vendor marketplace segments
  segments String[] @default([])

  // Business location
  country String @default("Nigeria")
  state   String?
  city    String?

  // Ratings
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  // Verification
  kycStatus    VerificationStatus @default(NOT_STARTED)
  payoutStatus VerificationStatus @default(NOT_STARTED)

  // Relationships
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings           Listing[]
  availabilityBlocks VendorAvailabilityBlock[]
  bookings           Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([city])
  @@index([averageRating])
  @@index([kycStatus])
  @@index([isFeatured])
}

model VerificationCode {
  id String @id @default(cuid())

  userId String

  codeHash String

  channel     VerificationChannel
  purpose     VerificationPurpose @default(SIGNUP)
  destination String

  expiresAt DateTime
  usedAt    DateTime?

  attempts Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}

model Session {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id String @id @default(cuid())

  vendorProfileId String

  title       String
  slug        String
  description String?

  category String

  // Money is stored in kobo
  priceKobo Int

  pricingUnit String?

  status      ListingStatus @default(DRAFT)
  isAvailable Boolean       @default(true)

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  cartItems CartItem[]
  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorProfileId, slug])
  @@index([vendorProfileId])
  @@index([status])
  @@index([category])
  @@index([priceKobo])
  @@index([isAvailable])
  @@index([category, priceKobo])
}

model VendorAvailabilityBlock {
  id String @id @default(cuid())

  vendorProfileId String

  startDate DateTime
  endDate   DateTime

  reason String?

  source AvailabilityBlockSource @default(MANUAL)

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorProfileId])
  @@index([startDate])
  @@index([endDate])
  @@index([vendorProfileId, startDate, endDate])
}

model Cart {
  id String @id @default(cuid())

  userId  String? @unique
  guestId String? @unique

  items CartItem[]

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestId])
}

model CartItem {
  id String @id @default(cuid())

  cartId    String
  listingId String

  quantity Int @default(1)

  startDate DateTime?
  endDate   DateTime?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([listingId])
}

model Booking {
  id String @id @default(cuid())

  customerId      String
  vendorProfileId String
  listingId       String

  startDate DateTime
  endDate   DateTime

  // Snapshot of price at booking time
  totalPriceKobo Int

  status BookingStatus @default(PENDING_VENDOR_APPROVAL)

  customer User          @relation("CustomerBookings", fields: [customerId], references: [id])
  vendor   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  listing  Listing       @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([vendorProfileId])
  @@index([listingId])
  @@index([status])
}
