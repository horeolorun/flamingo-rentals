
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AvailabilityBlockSource {
  MANUAL
  BOOKING
}

enum BookingStatus {
  PENDING_VENDOR_APPROVAL
  ACCEPTED
  REJECTED
  PAID
  CANCELLED
  COMPLETED
}

enum BookingCancellationActor {
  CUSTOMER
  VENDOR
  ADMIN
  SYSTEM
}

enum RefundStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  REFUNDED
  FAILED
}

enum BundleStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CartBundleType {
  VENDOR
  CUSTOMER
}

enum WalletPurpose {
  CUSTOMER_AVAILABLE
  CUSTOMER_DEPOSIT
  VENDOR_AVAILABLE
  VENDOR_PENDING
  PLATFORM_REVENUE
  PLATFORM_SUSPENSE
  PLATFORM_REFUND
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

model User {
  id        String  @id @default(cuid())
  fullName  String

  // Customer's saved location
  state     String?
  city      String?

  email     String? @unique
  phone     String? @unique

  passwordHash String?

  marketingEmailsOptIn   Boolean   @default(false)
  marketingEmailsOptInAt DateTime?

  role   UserRole      @default(CUSTOMER)
  status AccountStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  vendorProfile     VendorProfile?
  verificationCodes VerificationCode[]
  sessions          Session[]

  cart     Cart?
  bookings Booking[] @relation("CustomerBookings")

  // Customer wallets (null for non-customers). The user holds the reference.
  availableWalletId String? @unique
  depositWalletId   String? @unique

  availableWallet Wallet? @relation("UserAvailableWallet", fields: [availableWalletId], references: [id], onDelete: Restrict)
  depositWallet   Wallet? @relation("UserDepositWallet", fields: [depositWalletId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique

  businessName String?

  // Vendor branding
  logoUrl    String?
  isFeatured Boolean @default(false)

  // Legacy field retained temporarily
  primaryCategory String?

  // Vendor marketplace segments
  segments String[] @default([])

  // Business location
  country String @default("Nigeria")
  state   String?
  city    String?

  // Ratings
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  // Verification
  kycStatus    VerificationStatus @default(NOT_STARTED)
  payoutStatus VerificationStatus @default(NOT_STARTED)

  // Vendor wallets. The vendor profile holds the reference.
  availableWalletId String? @unique
  pendingWalletId   String? @unique

  availableWallet Wallet? @relation("VendorAvailableWallet", fields: [availableWalletId], references: [id], onDelete: Restrict)
  pendingWallet   Wallet? @relation("VendorPendingWallet", fields: [pendingWalletId], references: [id], onDelete: Restrict)

  // Relationships
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings           Listing[]
  availabilityBlocks VendorAvailabilityBlock[]
  bookings           Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([city])
  @@index([averageRating])
  @@index([kycStatus])
  @@index([isFeatured])
  vendorBundles VendorBundle[]
}

model VerificationCode {
  id String @id @default(cuid())

  userId String

  codeHash String

  channel     VerificationChannel
  purpose     VerificationPurpose @default(SIGNUP)
  destination String

  expiresAt DateTime
  usedAt    DateTime?

  attempts Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}

model Session {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id String @id @default(cuid())

  vendorProfileId String

  title       String
  slug        String
  description String?

  category String

  // Money is stored in kobo
  priceKobo Int
  // Total physical units available for this listing
  totalQuantity Int @default(1)
  pricingUnit String?

  status      ListingStatus @default(DRAFT)
  isAvailable Boolean       @default(true)

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  cartItems CartItem[]
  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorProfileId, slug])
  @@index([vendorProfileId])
  @@index([status])
  @@index([category])
  @@index([priceKobo])
  @@index([isAvailable])
  @@index([category, priceKobo])
  vendorBundleItems VendorBundleItem[]
cartBundleItems  CartBundleItem[]
}

model VendorAvailabilityBlock {
  id String @id @default(cuid())

  vendorProfileId String

  startDate DateTime
  endDate   DateTime

  reason String?

  source AvailabilityBlockSource @default(MANUAL)

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorProfileId])
  @@index([startDate])
  @@index([endDate])
  @@index([vendorProfileId, startDate, endDate])
}

model Cart {
  id String @id @default(cuid())

  userId  String? @unique
  guestId String? @unique

  items CartItem[]

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestId])
  bundles CartBundle[]
}

model CartItem {
  id String @id @default(cuid())

  cartId    String
  listingId String

  quantity Int @default(1)

  startDate DateTime?
  endDate   DateTime?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([listingId])
  isSelected Boolean @default(true)
}

model Booking {
  id String @id @default(cuid())

  customerId      String
  vendorProfileId String
  listingId       String

  startDate DateTime
  endDate   DateTime

  // Number of units requested
  quantity Int @default(1)

  // Snapshot of price at booking time
  totalPriceKobo Int

  status BookingStatus @default(PENDING_VENDOR_APPROVAL)

  // Cancellation information
  cancellationReason String?
  cancelledBy        BookingCancellationActor?
  cancelledAt        DateTime?

  // Refund tracking - independent of payment provider
  refundStatus       RefundStatus @default(NOT_REQUIRED)
  refundAmountKobo  Int?
  refundReference   String?
  refundRequestedAt DateTime?
  refundedAt        DateTime?

  customer User          @relation("CustomerBookings", fields: [customerId], references: [id])
  vendor   VendorProfile @relation(fields: [vendorProfileId], references: [id])
  listing  Listing       @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([vendorProfileId])
  @@index([listingId])
  @@index([status])
  @@index([listingId, status, startDate, endDate])
}

model VendorBundle {
  id String @id @default(cuid())

  vendorProfileId String

  title       String
  description String?

  // Vendor's fixed package price, stored in kobo
  priceKobo Int

  status BundleStatus @default(DRAFT)

  vendorProfile VendorProfile    @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  items         VendorBundleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorProfileId])
  @@index([status])
  cartBundles CartBundle[]
}

model VendorBundleItem {
  id String @id @default(cuid())

  bundleId  String
  listingId String

  quantity Int @default(1)

  bundle VendorBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  listing Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bundleId, listingId])
  @@index([listingId])
}

model CartBundle {
  id String @id @default(cuid())

  cartId String

  // VENDOR = fixed-price vendor package
  // CUSTOMER = customer-created collection
  type CartBundleType

  // Set only when this came from a vendor-created package
  vendorBundleId String?

  // Snapshot of the bundle details when added to cart
  title            String
  packagePriceKobo Int

  quantity   Int     @default(1)
  isSelected Boolean @default(true)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  vendorBundle VendorBundle? @relation(fields: [vendorBundleId], references: [id], onDelete: SetNull)

  items CartBundleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([vendorBundleId])
  @@index([type])
}

model CartBundleItem {
  id String @id @default(cuid())

  cartBundleId String
  listingId    String

  quantity Int @default(1)

  // Price per listing unit when the bundle entered the cart
  unitPriceKobo Int

  cartBundle CartBundle @relation(fields: [cartBundleId], references: [id], onDelete: Cascade)
  listing    Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartBundleId, listingId])
  @@index([listingId])
}  

model Wallet {
  id String @id @default(cuid())

  purpose  WalletPurpose
  currency String        @default("NGN")
  status   WalletStatus  @default(ACTIVE)

  // Money is stored as an exact decimal with 4 decimal places (naira, not kobo).
  // Cached projection of the ledger: never edited outside a ledger-posting routine.
  balance Decimal @default(0) @db.Decimal(19, 4)

  // Lowest balance the wallet may reach after a debit.
  // 0 = no overdraft; positive = amount that must stay in the wallet;
  // negative = permitted overdraft (e.g. vendor clawbacks).
  // Enforced in the service layer AND by a CHECK constraint (see migration note).
  minimumBalance Decimal @default(0) @db.Decimal(19, 4)

  // Whether the owner may initiate transfers/withdrawals from this wallet.
  // Defaults to false (safe); set true explicitly for the available-balance wallets.
  // System-driven movements (hold, release, refund) are governed by `status`.
  transfersAllowed Boolean @default(false)

  // Optimistic locking: increment on every balance change.
  version Int @default(0)

  // Back-relations (each wallet has at most one owner)
  customerAvailableOf User?          @relation("UserAvailableWallet")
  customerDepositOf   User?          @relation("UserDepositWallet")
  vendorAvailableOf   VendorProfile? @relation("VendorAvailableWallet")
  vendorPendingOf     VendorProfile? @relation("VendorPendingWallet")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purpose])
  @@index([status])
}

// One immutable line per posted wallet movement. Insert-only: no updatedAt.
model Statement {
  id String @id @default(cuid())

  // Scalar reference only (no Prisma relation, so Wallet carries no statements field).
  // The foreign key is added in the migration SQL.
  walletId String

  // Exactly one of inflow/outflow is non-zero on any line (CHECK in migration).
  inflow  Decimal @default(0) @db.Decimal(19, 4)
  outflow Decimal @default(0) @db.Decimal(19, 4)

  // Wallet balance immediately after this line posted
  balance Decimal @db.Decimal(19, 4)

  narration String
  reference String?

  // Plain columns for now. Become relations to Transaction and TransactionUnit
  // when those models are added.
  transactionId     String?
  transactionUnitId String? @unique

  postedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([walletId, postedAt])
  @@index([transactionId])
}